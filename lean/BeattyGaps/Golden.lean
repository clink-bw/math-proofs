/-- OEIS A351415. -/
noncomputable def S : Set ℤ := Beatty (√5) ∩ Beatty ((1 + √5) / 2)

/-! ## Numerical facts -/

theorem sq_sq : √5 * √5 = (5 : ℝ) := Real.mul_self_sqrt (by norm_num)

theorem sq_lo : (2.236 : ℝ) < √5 := by
  have h := sq_sq
  have h0 := Real.sqrt_nonneg (5 : ℝ)
  by_contra hc
  rw [not_lt] at hc
  nlinarith

theorem sq_hi : √5 < (2.2361 : ℝ) := by
  have h := sq_sq
  have h0 := Real.sqrt_nonneg (5 : ℝ)
  by_contra hc
  rw [not_lt] at hc
  nlinarith

theorem sq_pos : (0 : ℝ) < √5 := by linarith [sq_lo]

theorem sqm1_pos : (0 : ℝ) < √5 - 1 := by linarith [sq_lo]

theorem partner_pos : (0 : ℝ) < (1 + √5) / 2 := by linarith [sq_lo]

theorem partner_mul : ((1 + √5) / 2) * (√5 - 1) = (2 : ℝ) := by
  linear_combination (1 / 2 : ℝ) * sq_sq

