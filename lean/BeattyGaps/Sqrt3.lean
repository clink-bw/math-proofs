/-- **The gap set of OEIS A352676 is exactly `{2, 3, 5, 6}`.** -/
theorem isGap_iff {g : ℤ} (hg : 0 < g) :
    IsGap (S) g ↔ g = 2 ∨ g = 3 ∨ g = 5 ∨ g = 6 := by
  constructor
  · rintro ⟨m, hm, hmg, hbetween⟩
    rcases gaps hm with
      ⟨n1, h2⟩ |
      ⟨n1, n2, h3⟩ |
      ⟨n1, n2, n3, n4, h5⟩ |
      ⟨n1, n2, n3, n4, n5, h6⟩
    · left
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · obtain rfl : g = 1 := by omega
        exact n1 hmg
      · exact hbetween 2 (by norm_num) h h2
    · right; left
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · obtain rfl | rfl : g = 1 ∨ g = 2 := by omega
        exacts [n1 hmg, n2 hmg]
      · exact hbetween 3 (by norm_num) h h3
    · right; right; left
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · obtain rfl | rfl | rfl | rfl : g = 1 ∨ g = 2 ∨ g = 3 ∨ g = 4 := by omega
        exacts [n1 hmg, n2 hmg, n3 hmg, n4 hmg]
      · exact hbetween 5 (by norm_num) h h5
    · right; right; right
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · obtain rfl | rfl | rfl | rfl | rfl : g = 1 ∨ g = 2 ∨ g = 3 ∨ g = 4 ∨ g = 5 := by omega
        exacts [n1 hmg, n2 hmg, n3 hmg, n4 hmg, n5 hmg]
      · exact hbetween 6 (by norm_num) h h6
  · rintro (rfl | rfl | rfl | rfl)
    · refine ⟨8, mem8, by simpa using mem10, fun j h1 h2 => ?_⟩
      obtain rfl : j = 1 := by omega
      simpa using nmem9
    · refine ⟨5, mem5, by simpa using mem8, fun j h1 h2 => ?_⟩
      obtain rfl | rfl : j = 1 ∨ j = 2 := by omega
      · simpa using nmem6
      · simpa using nmem7
    · refine ⟨19, mem19, by simpa using mem24, fun j h1 h2 => ?_⟩
      obtain rfl | rfl | rfl | rfl : j = 1 ∨ j = 2 ∨ j = 3 ∨ j = 4 := by omega
