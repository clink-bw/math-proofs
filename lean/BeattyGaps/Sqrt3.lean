    (¬ A t s m 1 ∧ ¬ A t s m 2 ∧ A t s m 3 ∧ ⌊t + 4 * s⌋ - ⌊t + 1 * s⌋ = 5) ∨
    (¬ A t s m 1 ∧ ¬ A t s m 2 ∧ ¬ A t s m 3 ∧ ¬ A t s m 4 ∧ A t s m 5 ∧ ⌊t + 6 * s⌋ - ⌊t + 1 * s⌋ = 9) ∨
    (¬ A t s m 1 ∧ ¬ A t s m 2 ∧ ¬ A t s m 3 ∧ ¬ A t s m 4 ∧ ¬ A t s m 5 ∧ A t s m 6 ∧ ⌊t + 7 * s⌋ - ⌊t + 1 * s⌋ = 10) := by
  have hcl : (-2 : ℝ) < ((2 * l + m - 3 * k : ℤ) : ℝ) := by push_cast; linarith
  have hcu : ((2 * l + m - 3 * k : ℤ) : ℝ) < 1 := by push_cast; linarith
  have hcl' : (-2 : ℤ) < 2 * l + m - 3 * k := by exact_mod_cast hcl
  have hcu' : 2 * l + m - 3 * k < 1 := by exact_mod_cast hcu
  have hc : 2 * l + m - 3 * k = 0 ∨ 2 * l + m - 3 * k = -1 := by omega
  rcases hc with hc | hc
  · have hcR : 2 * (l : ℝ) + (m : ℝ) - 3 * (k : ℝ) = 0 := by exact_mod_cast hc
    rcases lt_or_ge (3 * (k : ℝ) - t) (3 * s - 5) with hb0 | hb0
    · right; right; left
      have f1 : ⌊t + 1 * s⌋ = 3 * k + 1 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      have f2 : ⌊t + 6 * s⌋ = 3 * k + 10 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      exact ⟨fun h => not_hit (by norm_num) (l) (by linarith) (by linarith) h.2,
        fun h => not_hit (by norm_num) (k + 1) (by push_cast; linarith) (by push_cast; linarith) h.1,
        fun h => not_hit (by norm_num) (l + 1) (by push_cast; linarith) (by push_cast; linarith) h.2,
        fun h => not_hit (by norm_num) (k + 2) (by push_cast; linarith) (by push_cast; linarith) h.1,
        ⟨⟨k + 3, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 2, by push_cast; linarith, by push_cast; linarith⟩⟩,
        by rw [f1, f2]; omega⟩
    rcases lt_or_ge (3 * (k : ℝ) - t) (2 * s - 3) with hb1 | hb1
    · right; left
      have f1 : ⌊t + 1 * s⌋ = 3 * k + 1 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      have f2 : ⌊t + 4 * s⌋ = 3 * k + 6 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      exact ⟨fun h => not_hit (by norm_num) (l) (by linarith) (by linarith) h.2,
        fun h => not_hit (by norm_num) (k + 1) (by push_cast; linarith) (by push_cast; linarith) h.1,
        ⟨⟨k + 2, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 1, by push_cast; linarith, by push_cast; linarith⟩⟩,
        by rw [f1, f2]; omega⟩
    · right; left
      have f1 : ⌊t + 1 * s⌋ = 3 * k + 1 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      have f2 : ⌊t + 4 * s⌋ = 3 * k + 6 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      exact ⟨fun h => not_hit (by norm_num) (k) (by linarith) (by linarith) h.1,
        fun h => not_hit (by norm_num) (l) (by linarith) (by linarith) h.2,
        ⟨⟨k + 2, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 1, by push_cast; linarith, by push_cast; linarith⟩⟩,
        by rw [f1, f2]; omega⟩
  · have hcR : 2 * (l : ℝ) + (m : ℝ) - 3 * (k : ℝ) = -1 := by exact_mod_cast hc
    rcases lt_or_ge (3 * (k : ℝ) - t) (3 * s - 4) with hb0 | hb0
    · left
      have f1 : ⌊t + 1 * s⌋ = 3 * k + 0 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      have f2 : ⌊t + 3 * s⌋ = 3 * k + 4 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      exact ⟨fun h => not_hit (by norm_num) (k) (by linarith) (by linarith) h.1,
        ⟨⟨k + 1, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 1, by push_cast; linarith, by push_cast; linarith⟩⟩,
        by rw [f1, f2]; omega⟩
    rcases lt_or_ge (3 * (k : ℝ) - t) (6 * s - 9) with hb1 | hb1
    · right; right; left
      have f1 : ⌊t + 1 * s⌋ = 3 * k + 0 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      have f2 : ⌊t + 6 * s⌋ = 3 * k + 9 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      exact ⟨fun h => not_hit (by norm_num) (k) (by linarith) (by linarith) h.1,
        fun h => not_hit (by norm_num) (l) (by linarith) (by linarith) h.2,
        fun h => not_hit (by norm_num) (k + 1) (by push_cast; linarith) (by push_cast; linarith) h.1,
        fun h => not_hit (by norm_num) (l + 1) (by push_cast; linarith) (by push_cast; linarith) h.2,
        ⟨⟨k + 3, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 2, by push_cast; linarith, by push_cast; linarith⟩⟩,
        by rw [f1, f2]; omega⟩
    · right; right; right
      have f1 : ⌊t + 1 * s⌋ = 3 * k + 0 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      have f2 : ⌊t + 7 * s⌋ = 3 * k + 10 :=
        Int.floor_eq_iff.mpr ⟨by push_cast; linarith, by push_cast; linarith⟩
      exact ⟨fun h => not_hit (by norm_num) (k) (by linarith) (by linarith) h.1,
        fun h => not_hit (by norm_num) (l) (by linarith) (by linarith) h.2,
        fun h => not_hit (by norm_num) (k + 1) (by push_cast; linarith) (by push_cast; linarith) h.1,
        fun h => not_hit (by norm_num) (l + 1) (by push_cast; linarith) (by push_cast; linarith) h.2,
        fun h => not_hit (by norm_num) (k + 2) (by push_cast; linarith) (by push_cast; linarith) h.1,
        ⟨⟨k + 3, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 2, by push_cast; linarith, by push_cast; linarith⟩⟩,
        by rw [f1, f2]; omega⟩

/-- **The walk step.**  For `m` in the intersection with next element `m + g`, the difference
`⌊(m + g + 1) √3⌋ - ⌊(m + 1) √3⌋` depends only on `g`. -/
theorem walk_step {m : ℤ} (hm : m ∈ S) :
    (m + 1 ∉ S ∧ m + 2 ∈ S ∧ ⌊((m + 3 : ℤ) : ℝ) * √3⌋ - ⌊((m + 1 : ℤ) : ℝ) * √3⌋ = 4) ∨
    (m + 1 ∉ S ∧ m + 2 ∉ S ∧ m + 3 ∈ S ∧ ⌊((m + 4 : ℤ) : ℝ) * √3⌋ - ⌊((m + 1 : ℤ) : ℝ) * √3⌋ = 5) ∨
    (m + 1 ∉ S ∧ m + 2 ∉ S ∧ m + 3 ∉ S ∧ m + 4 ∉ S ∧ m + 5 ∈ S ∧ ⌊((m + 6 : ℤ) : ℝ) * √3⌋ - ⌊((m + 1 : ℤ) : ℝ) * √3⌋ = 9) ∨
    (m + 1 ∉ S ∧ m + 2 ∉ S ∧ m + 3 ∉ S ∧ m + 4 ∉ S ∧ m + 5 ∉ S ∧ m + 6 ∈ S ∧ ⌊((m + 7 : ℤ) : ℝ) * √3⌋ - ⌊((m + 1 : ℤ) : ℝ) * √3⌋ = 10) := by
  have hm0 : 0 < m := pos_of_mem_S hm
  have h0 : A ((m : ℝ) * √3) (√3) m 0 :=
    (S_iff hm0 (j := 0) (jr := 0) le_rfl (by norm_num)).mp (by simpa using hm)
  obtain ⟨⟨k, hk1, hk2⟩, ⟨l, hl1, hl2⟩⟩ := h0
  have hcore := core_walk sq_lo sq_hi m k l (t := (m : ℝ) * √3)
    (by linarith) (by linarith) (by linarith) (by linarith)
  have e1 : ((m + 1 : ℤ) : ℝ) * √3 = (m : ℝ) * √3 + 1 * √3 := by push_cast; ring
  have e3 : ((m + 3 : ℤ) : ℝ) * √3 = (m : ℝ) * √3 + 3 * √3 := by push_cast; ring
  have e4 : ((m + 4 : ℤ) : ℝ) * √3 = (m : ℝ) * √3 + 4 * √3 := by push_cast; ring
  have e6 : ((m + 6 : ℤ) : ℝ) * √3 = (m : ℝ) * √3 + 6 * √3 := by push_cast; ring
  have e7 : ((m + 7 : ℤ) : ℝ) * √3 = (m : ℝ) * √3 + 7 * √3 := by push_cast; ring
  rw [S_iff hm0 (j := 1) (jr := 1) (by norm_num) (by norm_num),
    S_iff hm0 (j := 2) (jr := 2) (by norm_num) (by norm_num),
    S_iff hm0 (j := 3) (jr := 3) (by norm_num) (by norm_num),
    S_iff hm0 (j := 4) (jr := 4) (by norm_num) (by norm_num),
    S_iff hm0 (j := 5) (jr := 5) (by norm_num) (by norm_num),
    S_iff hm0 (j := 6) (jr := 6) (by norm_num) (by norm_num),
    e1, e3, e4, e6, e7]
  exact hcore

/-- The conjecture recorded in OEIS A352676 lists `4` among the gaps; it never occurs. -/
theorem four_not_gap : ¬ IsGap S 4 := by
  rw [isGap_iff (by norm_num)]
  norm_num

end BeattyGaps.Sqrt3
