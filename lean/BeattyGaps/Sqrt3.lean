/-! ## Translating Beatty membership into the coordinate `t = m √3` -/

theorem pos_of_mem_S {m : ℤ} (hm : m ∈ S) : 0 < m :=
  pos_of_mem_beatty (by linarith [sq_lo]) hm.1

theorem S_iff {m : ℤ} (hm : 0 < m) {j : ℤ} {jr : ℝ} (hj : 0 ≤ j) (hjr : (j : ℝ) = jr) :
    m + j ∈ S ↔ A ((m : ℝ) * √3) (√3) m jr := by
  subst hjr
  have hpos : 0 < m + j := by omega
  have e1 : ((m + j : ℤ) : ℝ) * √3 = (m : ℝ) * √3 + (j : ℝ) * √3 := by push_cast; ring
  have e2 : ((m + j : ℤ) : ℝ) * (√3 - 1)
      = (m : ℝ) * √3 + (j : ℝ) * √3 - (m : ℝ) - (j : ℝ) := by push_cast; ring
  unfold S
  rw [Set.mem_inter_iff, mem_beatty_iff_of_pos sq_pos hpos, mem_beatty_iff_of_pos partner_pos hpos,
    beatty_hit sq_pos sq_sq, beatty_hit sqm1_pos partner_mul, e2, e1]

/-! ## Main theorems -/

/-- After any element `m` of the intersection, the next element is `m + g` with
`g ∈ {2, 3, 5, 6}`. -/
theorem gaps {m : ℤ} (hm : m ∈ S) :
    (m + 1 ∉ S ∧ m + 2 ∈ S) ∨
    (m + 1 ∉ S ∧ m + 2 ∉ S ∧ m + 3 ∈ S) ∨
    (m + 1 ∉ S ∧ m + 2 ∉ S ∧ m + 3 ∉ S ∧ m + 4 ∉ S ∧ m + 5 ∈ S) ∨
    (m + 1 ∉ S ∧ m + 2 ∉ S ∧ m + 3 ∉ S ∧ m + 4 ∉ S ∧ m + 5 ∉ S ∧ m + 6 ∈ S) := by
  have hm0 : 0 < m := pos_of_mem_S hm
  have h0 : A ((m : ℝ) * √3) (√3) m 0 :=
    (S_iff hm0 (j := 0) (jr := 0) le_rfl (by norm_num)).mp (by simpa using hm)
  obtain ⟨⟨k, hk1, hk2⟩, ⟨l, hl1, hl2⟩⟩ := h0
  have hcore := core sq_lo sq_hi m k l (t := (m : ℝ) * √3)
    (by linarith) (by linarith) (by linarith) (by linarith)
  rw [S_iff hm0 (j := 1) (jr := 1) (by norm_num) (by norm_num),
    S_iff hm0 (j := 2) (jr := 2) (by norm_num) (by norm_num),
    S_iff hm0 (j := 3) (jr := 3) (by norm_num) (by norm_num),
    S_iff hm0 (j := 4) (jr := 4) (by norm_num) (by norm_num),
    S_iff hm0 (j := 5) (jr := 5) (by norm_num) (by norm_num),
    S_iff hm0 (j := 6) (jr := 6) (by norm_num) (by norm_num)]
  exact hcore

