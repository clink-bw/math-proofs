/-! ## Numerical facts -/

theorem sq_sq : √3 * √3 = (3 : ℝ) := Real.mul_self_sqrt (by norm_num)

theorem sq_lo : (1.732 : ℝ) < √3 := by
  have h := sq_sq
  have h0 := Real.sqrt_nonneg (3 : ℝ)
  by_contra hc
  rw [not_lt] at hc
  nlinarith

theorem sq_hi : √3 < (1.7321 : ℝ) := by
  have h := sq_sq
  have h0 := Real.sqrt_nonneg (3 : ℝ)
  by_contra hc
  rw [not_lt] at hc
  nlinarith

theorem sq_pos : (0 : ℝ) < √3 := by linarith [sq_lo]

theorem sqm1_pos : (0 : ℝ) < √3 - 1 := by linarith [sq_lo]

theorem partner_pos : (0 : ℝ) < 1 + √3 := by linarith [sq_lo]

theorem partner_mul : (1 + √3) * (√3 - 1) = (2 : ℝ) := by
  linear_combination sq_sq

