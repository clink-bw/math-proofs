/-- The statement for the real cube root of two written as a power. -/
theorem isGap_iff_cbrt {g : ℤ} (hg : 0 < g) :
    IsGap (S ((2 : ℝ) ^ ((1 : ℝ) / 3))) g ↔ g = 1 ∨ g = 2 ∨ g = 3 ∨ g = 4 :=
  isGap_iff (by positivity)
    (by rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num)]; norm_num) hg

