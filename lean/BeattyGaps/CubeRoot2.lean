/-- OEIS A347793, for `c` the real cube root of `2`: the integers in both the Beatty sequence
of `c` and that of `c ^ 2`. -/
def S (c : ℝ) : Set ℤ := Beatty c ∩ Beatty (c ^ 2)

/-! ## Numerical facts about the cube root of 2 -/

theorem c_lo (hc : 0 < c) (hc3 : c ^ 3 = 2) : (1.2599 : ℝ) < c := by
  by_contra h
  rw [not_lt] at h
  have h2 : c * c ≤ 1.2599 * 1.2599 := mul_le_mul h h hc.le (by norm_num)
  have h3 : c * c * c ≤ 1.2599 * 1.2599 * 1.2599 := mul_le_mul h2 h hc.le (by norm_num)
  have e : c * c * c = 2 := by rw [← hc3]; ring
  norm_num at h3
  linarith

theorem c_hi (hc : 0 < c) (hc3 : c ^ 3 = 2) : c < (1.26 : ℝ) := by
  by_contra h
  rw [not_lt] at h
  have h2 : (1.26 : ℝ) * 1.26 ≤ c * c := mul_le_mul h h (by norm_num) hc.le
  have h3 : (1.26 : ℝ) * 1.26 * 1.26 ≤ c * c * c :=
    mul_le_mul h2 h (by norm_num) (mul_nonneg hc.le hc.le)
  have e : c * c * c = 2 := by rw [← hc3]; ring
  norm_num at h3
  linarith

theorem r_lo (hc : 0 < c) (hc3 : c ^ 3 = 2) : (1.5873 : ℝ) < c ^ 2 := by
  have h := c_lo hc hc3
  nlinarith [mul_pos (sub_pos.mpr h) (sub_pos.mpr h)]

theorem r_hi (hc : 0 < c) (hc3 : c ^ 3 = 2) : c ^ 2 < (1.5876 : ℝ) := by
  have h := c_hi hc hc3
  nlinarith [mul_pos (sub_pos.mpr h) (by linarith : (0 : ℝ) < 1.26 + c)]

theorem r_pos (hc : 0 < c) : (0 : ℝ) < c ^ 2 := by positivity

theorem c_mul_sq (hc3 : c ^ 3 = 2) : c * c ^ 2 = 2 := by linear_combination hc3

theorem sq_mul_c (hc3 : c ^ 3 = 2) : c ^ 2 * c = 2 := by linear_combination hc3

/-! ## The case analysis -/

/-- In the coordinates `t = m r`, `u = m s`: "`m + j` lies in both Beatty sequences". -/
abbrev A (t u r s : ℝ) (j : ℝ) : Prop :=
  Hit (t + j * r) r 2 ∧ Hit (u + j * s) s 2

theorem core {t u r s : ℝ} (hrlo : 1.5873 < r) (hrhi : r < 1.5876)
