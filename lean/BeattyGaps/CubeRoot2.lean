/-- **The gap set of OEIS A347793 is exactly `{1, 2, 3, 4}`.** -/
theorem isGap_iff (hc : 0 < c) (hc3 : c ^ 3 = 2) {g : ℤ} (hg : 0 < g) :
    IsGap (S c) g ↔ g = 1 ∨ g = 2 ∨ g = 3 ∨ g = 4 := by
  constructor
  · rintro ⟨m, hm, hmg, hbetween⟩
    rcases gaps hc hc3 hm with
      h1 |
      ⟨n1, h2⟩ |
      ⟨n1, n2, h3⟩ |
      ⟨n1, n2, n3, h4⟩
    · left
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · omega
      · exact hbetween 1 (by norm_num) h h1
    · right; left
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · obtain rfl : g = 1 := by omega
        exact n1 hmg
      · exact hbetween 2 (by norm_num) h h2
    · right; right; left
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · obtain rfl | rfl : g = 1 ∨ g = 2 := by omega
        exacts [n1 hmg, n2 hmg]
      · exact hbetween 3 (by norm_num) h h3
    · right; right; right
      by_contra hne
      rcases lt_or_gt_of_ne hne with h | h
      · obtain rfl | rfl | rfl : g = 1 ∨ g = 2 ∨ g = 3 := by omega
        exacts [n1 hmg, n2 hmg, n3 hmg]
      · exact hbetween 4 (by norm_num) h h4
  · rintro (rfl | rfl | rfl | rfl)
    · refine ⟨6, mem6 hc hc3, by simpa using mem7 hc hc3, fun j h1 h2 => ?_⟩
      exfalso; omega
    · refine ⟨1, mem1 hc hc3, by simpa using mem3 hc hc3, fun j h1 h2 => ?_⟩
      obtain rfl : j = 1 := by omega
      simpa using nmem2 hc hc3
    · refine ⟨3, mem3 hc hc3, by simpa using mem6 hc hc3, fun j h1 h2 => ?_⟩
      obtain rfl | rfl : j = 1 ∨ j = 2 := by omega
