/-! ## Translating Beatty membership into the coordinates -/

theorem pos_of_mem_S (hc : 0 < c) (hc3 : c ^ 3 = 2) {m : ℤ} (hm : m ∈ S c) : 0 < m :=
  pos_of_mem_beatty (by linarith [c_lo hc hc3]) hm.1

theorem S_iff (hc : 0 < c) (hc3 : c ^ 3 = 2) {m : ℤ} (hm : 0 < m) {j : ℤ} {jr : ℝ} (hj : 0 ≤ j) (hjr : (j : ℝ) = jr) :
    m + j ∈ S c ↔ A ((m : ℝ) * c ^ 2) ((m : ℝ) * c) (c ^ 2) (c) jr := by
  subst hjr
  have hpos : 0 < m + j := by omega
  have e1 : ((m + j : ℤ) : ℝ) * c ^ 2 = (m : ℝ) * c ^ 2 + (j : ℝ) * c ^ 2 := by push_cast; ring
  have e2 : ((m + j : ℤ) : ℝ) * c = (m : ℝ) * c + (j : ℝ) * c := by push_cast; ring
  unfold S
  rw [Set.mem_inter_iff, mem_beatty_iff_of_pos (hc) hpos,
    mem_beatty_iff_of_pos (r_pos hc) hpos,
    beatty_hit (r_pos hc) (c_mul_sq hc3), beatty_hit (hc) (sq_mul_c hc3), e1, e2]

/-! ## Main theorems -/

/-- After any element `m` of the intersection, the next element is `m + g` with
`g ∈ {1, 2, 3, 4}`. -/
theorem gaps (hc : 0 < c) (hc3 : c ^ 3 = 2) {m : ℤ} (hm : m ∈ S c) :
    (m + 1 ∈ S c) ∨
    (m + 1 ∉ S c ∧ m + 2 ∈ S c) ∨
    (m + 1 ∉ S c ∧ m + 2 ∉ S c ∧ m + 3 ∈ S c) ∨
    (m + 1 ∉ S c ∧ m + 2 ∉ S c ∧ m + 3 ∉ S c ∧ m + 4 ∈ S c) := by
  have hm0 : 0 < m := pos_of_mem_S hc hc3 hm
  have h0 : A ((m : ℝ) * c ^ 2) ((m : ℝ) * c) (c ^ 2) (c) 0 :=
    (S_iff hc hc3 hm0 (j := 0) (jr := 0) le_rfl (by norm_num)).mp (by simpa using hm)
  obtain ⟨⟨k, hk1, hk2⟩, ⟨l, hl1, hl2⟩⟩ := h0
  have hcore := core (r_lo hc hc3) (r_hi hc hc3) (c_lo hc hc3) (c_hi hc hc3) k l
    (t := (m : ℝ) * c ^ 2) (u := (m : ℝ) * c)
    (by linarith) (by linarith) (by linarith) (by linarith)
  rw [S_iff hc hc3 hm0 (j := 1) (jr := 1) (by norm_num) (by norm_num),
    S_iff hc hc3 hm0 (j := 2) (jr := 2) (by norm_num) (by norm_num),
    S_iff hc hc3 hm0 (j := 3) (jr := 3) (by norm_num) (by norm_num),
    S_iff hc hc3 hm0 (j := 4) (jr := 4) (by norm_num) (by norm_num)]
  exact hcore

