        ⟨⟨k + 2, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 1, by push_cast; linarith, by push_cast; linarith⟩⟩⟩
  -- a in [3 * r - 4, 2 * r - 2)
  rcases lt_or_ge (2 * (k : ℝ) - t) (2 * r - 2) with ha1 | ha1
  · rcases lt_or_ge (2 * (l : ℝ) - u) (2 * s - 2) with hb0 | hb0
    · left
      exact ⟨⟨k + 1, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 1, by push_cast; linarith, by push_cast; linarith⟩⟩
    rcases lt_or_ge (2 * (l : ℝ) - u) (4 * s - 4) with hb1 | hb1
    · right; right; left
      exact ⟨fun h => not_hit (by norm_num) (l) (by linarith) (by linarith) h.2,
        fun h => not_hit (by norm_num) (k + 1) (by push_cast; linarith) (by push_cast; linarith) h.1,
