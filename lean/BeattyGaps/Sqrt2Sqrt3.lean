/-! ## The case analysis -/

/-- In the coordinates `t = m r`, `u = m s`: "`m + j` lies in both Beatty sequences". -/
abbrev A (t u r s : ℝ) (j : ℝ) : Prop :=
  Hit (t + j * r) r 2 ∧ Hit (u + j * s) s 3

theorem core {t u r s : ℝ} (hrlo : 1.4142 < r) (hrhi : r < 1.4143)
    (hslo : 1.732 < s) (hshi : s < 1.7321) (k l : ℤ)
    (h1 : t ≤ 2 * (k : ℝ)) (h2 : 2 * (k : ℝ) < t + r)
    (h3 : u ≤ 3 * (l : ℝ)) (h4 : 3 * (l : ℝ) < u + s) :
    (A t u r s 1) ∨
    (¬ A t u r s 1 ∧ A t u r s 2) ∨
    (¬ A t u r s 1 ∧ ¬ A t u r s 2 ∧ A t u r s 3) ∨
    (¬ A t u r s 1 ∧ ¬ A t u r s 2 ∧ ¬ A t u r s 3 ∧ A t u r s 4) := by
  -- a in [0, 3 * r - 4)
  rcases lt_or_ge (2 * (k : ℝ) - t) (3 * r - 4) with ha0 | ha0
  · rcases lt_or_ge (3 * (l : ℝ) - u) (2 * s - 3) with hb0 | hb0
    · left
      exact ⟨⟨k + 1, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 1, by push_cast; linarith, by push_cast; linarith⟩⟩
    · right; left
      exact ⟨fun h => not_hit (by norm_num) (l) (by linarith) (by linarith) h.2,
        ⟨⟨k + 2, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 1, by push_cast; linarith, by push_cast; linarith⟩⟩⟩
  -- a in [3 * r - 4, 2 * r - 2)
  rcases lt_or_ge (2 * (k : ℝ) - t) (2 * r - 2) with ha1 | ha1
  · rcases lt_or_ge (3 * (l : ℝ) - u) (2 * s - 3) with hb0 | hb0
    · left
      exact ⟨⟨k + 1, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 1, by push_cast; linarith, by push_cast; linarith⟩⟩
    rcases lt_or_ge (3 * (l : ℝ) - u) (4 * s - 6) with hb1 | hb1
    · right; right; left
      exact ⟨fun h => not_hit (by norm_num) (l) (by linarith) (by linarith) h.2,
        fun h => not_hit (by norm_num) (k + 1) (by push_cast; linarith) (by push_cast; linarith) h.1,
        ⟨⟨k + 2, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 2, by push_cast; linarith, by push_cast; linarith⟩⟩⟩
    · right; right; right
      exact ⟨fun h => not_hit (by norm_num) (l) (by linarith) (by linarith) h.2,
        fun h => not_hit (by norm_num) (k + 1) (by push_cast; linarith) (by push_cast; linarith) h.1,
        fun h => not_hit (by norm_num) (l + 1) (by push_cast; linarith) (by push_cast; linarith) h.2,
        ⟨⟨k + 3, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 2, by push_cast; linarith, by push_cast; linarith⟩⟩⟩
  -- a in [2 * r - 2, r)
  · rcases lt_or_ge (3 * (l : ℝ) - u) (2 * s - 3) with hb0 | hb0
    · right; right; left
      exact ⟨fun h => not_hit (by norm_num) (k) (by linarith) (by linarith) h.1,
        fun h => not_hit (by norm_num) (l + 1) (by push_cast; linarith) (by push_cast; linarith) h.2,
        ⟨⟨k + 2, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 2, by push_cast; linarith, by push_cast; linarith⟩⟩⟩
    · right; left
      exact ⟨fun h => not_hit (by norm_num) (k) (by linarith) (by linarith) h.1,
        ⟨⟨k + 1, by push_cast; linarith, by push_cast; linarith⟩, ⟨l + 1, by push_cast; linarith, by push_cast; linarith⟩⟩⟩

/-! ## Translating Beatty membership into the coordinates -/

theorem pos_of_mem_S {m : ℤ} (hm : m ∈ S) : 0 < m :=
  pos_of_mem_beatty (by linarith [r_lo]) hm.1

theorem S_iff {m : ℤ} (hm : 0 < m) {j : ℤ} {jr : ℝ} (hj : 0 ≤ j) (hjr : (j : ℝ) = jr) :
    m + j ∈ S ↔ A ((m : ℝ) * √2) ((m : ℝ) * √3) (√2) (√3) jr := by
  subst hjr
  have hpos : 0 < m + j := by omega
  have e1 : ((m + j : ℤ) : ℝ) * √2 = (m : ℝ) * √2 + (j : ℝ) * √2 := by push_cast; ring
  have e2 : ((m + j : ℤ) : ℝ) * √3 = (m : ℝ) * √3 + (j : ℝ) * √3 := by push_cast; ring
  unfold S
  rw [Set.mem_inter_iff, mem_beatty_iff_of_pos (r_pos) hpos,
    mem_beatty_iff_of_pos (s_pos) hpos,
    beatty_hit (r_pos) (r_sq), beatty_hit (s_pos) (s_sq), e1, e2]

/-! ## Main theorems -/

/-- After any element `m` of the intersection, the next element is `m + g` with
`g ∈ {1, 2, 3, 4}`. -/
theorem gaps {m : ℤ} (hm : m ∈ S) :
    (m + 1 ∈ S) ∨
    (m + 1 ∉ S ∧ m + 2 ∈ S) ∨
    (m + 1 ∉ S ∧ m + 2 ∉ S ∧ m + 3 ∈ S) ∨
    (m + 1 ∉ S ∧ m + 2 ∉ S ∧ m + 3 ∉ S ∧ m + 4 ∈ S) := by
  have hm0 : 0 < m := pos_of_mem_S hm
  have h0 : A ((m : ℝ) * √2) ((m : ℝ) * √3) (√2) (√3) 0 :=
    (S_iff hm0 (j := 0) (jr := 0) le_rfl (by norm_num)).mp (by simpa using hm)
  obtain ⟨⟨k, hk1, hk2⟩, ⟨l, hl1, hl2⟩⟩ := h0
  have hcore := core (r_lo) (r_hi) (s_lo) (s_hi) k l
    (t := (m : ℝ) * √2) (u := (m : ℝ) * √3)
    (by linarith) (by linarith) (by linarith) (by linarith)
  rw [S_iff hm0 (j := 1) (jr := 1) (by norm_num) (by norm_num),
    S_iff hm0 (j := 2) (jr := 2) (by norm_num) (by norm_num),
    S_iff hm0 (j := 3) (jr := 3) (by norm_num) (by norm_num),
    S_iff hm0 (j := 4) (jr := 4) (by norm_num) (by norm_num)]
  exact hcore

