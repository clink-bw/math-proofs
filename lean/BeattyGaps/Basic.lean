import Mathlib

/-!
# Intersections of Beatty sequences: shared definitions and lemmas

`Beatty r` is the set `{⌊k r⌋ : k = 1, 2, 3, …}`.  The files `Sqrt3`, `Golden`, `Sqrt2Sqrt3` and
`CubeRoot2` each determine the exact set of gaps of one intersection `Beatty α ∩ Beatty β`.

Generated by `beatty-intersections/compute/gen_lean.py`; edit the generator, not this file.
-/

set_option linter.style.longLine false

namespace BeattyGaps

/-- The Beatty sequence of `r`, as a set: `{⌊k r⌋ : k = 1, 2, 3, …}`. -/
def Beatty (r : ℝ) : Set ℤ := {m | ∃ k : ℤ, 0 < k ∧ ⌊(k : ℝ) * r⌋ = m}

/-- `Beatty` agrees with Mathlib's `beattySeq` restricted to positive indices. -/
theorem beatty_eq (r : ℝ) : Beatty r = {beattySeq r k | k > 0} := rfl

/-- `g` is a gap of `S`: two members of `S` at distance `g` with no member strictly between. -/
def IsGap (S : Set ℤ) (g : ℤ) : Prop :=
  ∃ m ∈ S, m + g ∈ S ∧ ∀ j : ℤ, 0 < j → j < g → m + j ∉ S

/-- Some integer multiple of `p` lies in the half-open interval `[x, x + w)`. -/
abbrev Hit (x w p : ℝ) : Prop := ∃ k : ℤ, x ≤ p * (k : ℝ) ∧ p * (k : ℝ) < x + w

theorem not_hit {x w p : ℝ} (hp : 0 < p) (k₀ : ℤ) (h1 : p * (k₀ : ℝ) < x)
    (h2 : x + w ≤ p * ((k₀ : ℝ) + 1)) : ¬ Hit x w p := by
  rintro ⟨k, hk1, hk2⟩
  rcases lt_or_ge k₀ k with h | h
  · have h0 : k₀ + 1 ≤ k := h
    have h' : (k₀ : ℝ) + 1 ≤ k := by exact_mod_cast h0
    have := mul_le_mul_of_nonneg_left h' hp.le
    linarith
  · have h' : (k : ℝ) ≤ k₀ := by exact_mod_cast h
    have := mul_le_mul_of_nonneg_left h' hp.le
    linarith

theorem mem_beatty_iff_of_pos {r : ℝ} (hr : 0 < r) {m : ℤ} (hm : 0 < m) :
    m ∈ Beatty r ↔ ∃ k : ℤ, ⌊(k : ℝ) * r⌋ = m := by
  constructor
  · rintro ⟨k, -, hk⟩
    exact ⟨k, hk⟩
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_, hk⟩
    by_contra hneg
    have hk0 : (k : ℝ) ≤ 0 := by exact_mod_cast not_lt.mp hneg
    have h1 : (k : ℝ) * r ≤ 0 := by nlinarith
    have h2 : ((⌊(k : ℝ) * r⌋ : ℤ) : ℝ) ≤ 0 := le_trans (Int.floor_le _) h1
    have h3 : ⌊(k : ℝ) * r⌋ ≤ 0 := by exact_mod_cast h2
    omega

theorem pos_of_mem_beatty {r : ℝ} (hr : 1 ≤ r) {m : ℤ} (hm : m ∈ Beatty r) : 0 < m := by
  obtain ⟨k, hk, rfl⟩ := hm
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have h : ((1 : ℤ) : ℝ) ≤ (k : ℝ) * r := by push_cast; nlinarith
  have := Int.le_floor.mpr h
  omega

/-- If `s * s' = d`, then `n = ⌊k s⌋` for some `k` exactly when a multiple of `d` lies in
`[n s', n s' + s')`. -/
theorem beatty_hit {s s' d : ℝ} (hs' : 0 < s') (h : s * s' = d) (n : ℤ) :
    (∃ k : ℤ, ⌊(k : ℝ) * s⌋ = n) ↔ Hit ((n : ℝ) * s') s' d := by
  have e : ∀ k : ℤ, (k : ℝ) * s * s' = d * (k : ℝ) := fun k => by rw [mul_assoc, h]; ring
  constructor
  · rintro ⟨k, hk⟩
    rw [Int.floor_eq_iff] at hk
    refine ⟨k, ?_, ?_⟩
    · have := mul_le_mul_of_nonneg_right hk.1 hs'.le
      linarith [e k]
    · have := mul_lt_mul_of_pos_right hk.2 hs'
      linarith [e k]
  · rintro ⟨k, hk1, hk2⟩
    refine ⟨k, Int.floor_eq_iff.mpr ⟨?_, ?_⟩⟩
    · refine le_of_mul_le_mul_right ?_ hs'
      linarith [e k]
    · refine lt_of_mul_lt_mul_right ?_ hs'.le
      linarith [e k]

theorem mem_inter_of {r₁ r₂ : ℝ} {m : ℤ} (k l : ℤ) (hk : 0 < k) (hl : 0 < l)
    (h1 : (m : ℝ) ≤ (k : ℝ) * r₁) (h2 : (k : ℝ) * r₁ < (m : ℝ) + 1)
    (h3 : (m : ℝ) ≤ (l : ℝ) * r₂) (h4 : (l : ℝ) * r₂ < (m : ℝ) + 1) :
    m ∈ Beatty r₁ ∩ Beatty r₂ :=
  ⟨⟨k, hk, Int.floor_eq_iff.mpr ⟨h1, h2⟩⟩, ⟨l, hl, Int.floor_eq_iff.mpr ⟨h3, h4⟩⟩⟩

/-- `n` is not in the Beatty sequence of `r`: it lies strictly between two consecutive terms. -/
theorem not_mem_beatty {r : ℝ} (hr : 0 < r) {n : ℤ} (k₀ : ℤ)
    (h1 : (k₀ : ℝ) * r < (n : ℝ)) (h2 : (n : ℝ) + 1 ≤ ((k₀ : ℝ) + 1) * r) : n ∉ Beatty r := by
  rintro ⟨k, -, hk⟩
  rw [Int.floor_eq_iff] at hk
  rcases lt_or_ge k₀ k with h | h
  · have h0 : k₀ + 1 ≤ k := h
    have h' : (k₀ : ℝ) + 1 ≤ k := by exact_mod_cast h0
    have := mul_le_mul_of_nonneg_right h' hr.le
    linarith [hk.2]
  · have h' : (k : ℝ) ≤ k₀ := by exact_mod_cast h
    have := mul_le_mul_of_nonneg_right h' hr.le
    linarith [hk.1]

end BeattyGaps
