  decide +kernel

/-- All checks of the lower-bound certificate pass. -/
theorem valid : cert.Valid :=
  ⟨start_ok, size_ok, st_ok, trans_ok, steps_ok, link_ok, stat_ok, fin_ok⟩

/-- The value of `γ_{2}(P_5 □ P_n)` for `n ≥ 1`: `⌈(23 n + 17) / 10⌉`, corrected at the
finitely many small `n` where the true value differs by one. -/
def gamma (n : ℕ) : ℕ :=
  if n ∈ [2, 3, 5, 6, 8, 9, 12, 15, 18] then (23 * n + 26) / 10 - 1
  else (23 * n + 26) / 10

/-- For `1 ≤ n < 19`: every final state has lower bound at least `gamma n` after `n` columns. -/
theorem small_ok :
    ((List.range' 1 18).all fun n => finOK cert.fins (cert.tab n) (gamma n)) = true := by
  decide +kernel

