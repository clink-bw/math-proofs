theorem stat_ok : ∀ ch, ch < cert.nch →
    chunkOK (relaxRow cert.m cert.F cert.F cert.K cert.R) cert.rows cert.chunk ch = true
  | 0, _ => stat_ok_0
  | 1, _ => stat_ok_1
  | 2, _ => stat_ok_2
  | 3, _ => stat_ok_3
  | 4, _ => stat_ok_4
  | 5, _ => stat_ok_5
  | 6, _ => stat_ok_6
  | 7, _ => stat_ok_7
  | ch + 8, h => absurd h (by change ¬ (ch + 8 < 8); omega)

