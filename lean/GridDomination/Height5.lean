/-!
# The `{2}`-domination number of the `5 × n` grid

Generated by `grid-domination/compute/gen_lean.py`; edit the generator, not this file.

* `domNum_grid_five`: `γ_{2}(P_5 □ P_n) = Height5.gamma n` for every `n ≥ 1`, where
  `Height5.gamma n` is `⌈(23 n + 17) / 10⌉`, except that it is one less for
  `n = 2, 3, 5, 6, 8, 9, 12, 15, 18`.
* `domNum_grid_five_of_ge`: `γ_{2}(P_5 □ P_n) = ⌈(23 n + 17) / 10⌉` for every `n ≥ 19`.
-/

namespace GridDomination

open Finset

namespace Height5

theorem gamma_of_ge {n : ℕ} (hn : 19 ≤ n) : gamma n = (23 * n + 26) / 10 := by
  have h0 : ¬ n ∈ [2, 3, 5, 6, 8, 9, 12, 15, 18] := by
    intro h
    simp at h
    omega
  unfold gamma
  rw [ite_eq_right h0]

/-- Every `{2}`-dominating function of the `5 × n` grid weighs at least `gamma n`. -/
theorem lower {n : ℕ} (hn : 1 ≤ n) (f : Fin 5 × Fin n → ℕ) (hf : IsDomFn (grid 5 n) 2 f) :
    gamma n ≤ ∑ v, f v := by
  rcases Nat.lt_or_ge n 19 with hJ | hJ
  · have hg := List.all_eq_true.mp small_ok n (List.mem_range'_1.mpr ⟨hn, by omega⟩)
    exact valid.lower_grid_small (n := n) (show n ≤ 19 by omega) hg f hf
  · have h : 17 + 23 * n ≤ 10 * ∑ v, f v := valid.lower_grid (n := n) hJ f hf
    rw [gamma_of_ge hJ]
    omega

/-- Some `{2}`-dominating function of the `5 × n` grid with values in `{0,1,2}` weighs
exactly `gamma n`. -/
theorem upper {n : ℕ} (hn : 1 ≤ n) :
    ∃ f : Fin 5 × Fin n → ℕ, IsDomFn (grid 5 n) 2 f ∧ (∀ v, f v ≤ 2) ∧ ∑ v, f v = gamma n := by
  rcases Nat.lt_or_ge n 19 with h0 | h0
  · exact exists_dom_of_accept
      (List.all_eq_true.mp words_ok n (List.mem_range'_1.mpr ⟨hn, by omega⟩))
  · have hp := all_range pump_ok (Nat.mod_lt n (show 0 < 20 by norm_num))
    obtain ⟨hp12, hp3⟩ := and_true_split hp
    obtain ⟨hp1, hp2⟩ := and_true_split hp12
    have hmod := Nat.eq_of_beq_eq_true hp2
    have hlt : baseL.getD (n % 20) 0 < 19 + 20 := Nat.le_of_ble_eq_true hp3
    generalize baseL.getD (n % 20) 0 = L at hp1 hmod hlt
    obtain ⟨f, hf, hb, hs⟩ := exists_dom_of_pump hp1 (n := n) (k := (n - L) / 20) (by omega)
    exact ⟨f, hf, hb, by rw [hs, gamma_of_ge (show 19 ≤ n by omega)]; omega⟩

end Height5

/-- The integer `{2}`-domination number of the `5 × n` grid, for every `n ≥ 1`. -/
theorem domNum_grid_five (n : ℕ) (hn : 1 ≤ n) : domNum (grid 5 n) 2 = Height5.gamma n := by
  obtain ⟨f, hf, -, hs⟩ := Height5.upper hn
  exact domNum_eq ⟨f, hf, hs⟩ (fun g hg => Height5.lower hn g hg)

/-- The integer `{2}`-domination number of the `5 × n` grid is `⌈(23 n + 17) / 10⌉`, for every
`n ≥ 19`. -/
theorem domNum_grid_five_of_ge (n : ℕ) (hn : 19 ≤ n) :
    domNum (grid 5 n) 2 = (23 * n + 26) / 10 := by
  rw [domNum_grid_five n (by omega), Height5.gamma_of_ge hn]

/-- The threshold 19 cannot be lowered: for `n = 18` the value is 43, one less than the formula
gives. -/
theorem domNum_grid_five_18 : domNum (grid 5 18) 2 = 43 := by
  rw [domNum_grid_five 18 (by norm_num)]
  decide

/-- The minimum for the `5 × n` grid is attained by a function with values in `{0, 1, 2}`, so it
does not matter whether weights above 2 are allowed. -/
theorem exists_dom_grid_five (n : ℕ) (hn : 1 ≤ n) :
    ∃ f : Fin 5 × Fin n → ℕ, IsDomFn (grid 5 n) 2 f ∧ (∀ v, f v ≤ 2) ∧
      ∑ v, f v = Height5.gamma n :=
  Height5.upper hn

end GridDomination
